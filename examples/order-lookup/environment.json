{
  "engine": "n8n",
  "environment_id": "local-order-lookup-baseline",
  "extensions": {
    "flowdelta.semantic_profile": "order-lookup-local-v1"
  },
  "http_endpoints": [
    {
      "description_basis": "DECLARED_ONLY",
      "endpoint_id": "order-lookup",
      "method": "GET",
      "response_fields": [
        "order_id",
        "status"
      ],
      "response_shape": "SINGLE_JSON_OBJECT",
      "url": "http://orders-api:8080/orders/lookup"
    }
  ],
  "runtime_status": "NOT_VALIDATED",
  "schema_version": "0.4.0",
  "service_bindings": {
    "orders": {
      "base_url": "http://orders-api:8080",
      "kind": "team-synthetic-service",
      "principal_binding": "fd-service-auth -> customer-demo / tenant-demo",
      "scope": "own-order-read-only"
    }
  },
  "target_version": "2.42.6"
}
