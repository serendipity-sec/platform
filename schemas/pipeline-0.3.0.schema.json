        "comparison_run_id",
        "case_id",
        "plan_id",
        "side",
        "snapshot_id",
        "authorship",
        "runtime_profile",
        "actual_engine_version",
        "actual_image_digest",
        "initial_state_sha256",
        "phase",
        "execution_status",
        "cleanup_status",
