    "AnalysisBundle": {
      "additionalProperties": false,
      "properties": {
        "after_graph": {
          "$ref": "#/$defs/SemanticGraph"
        },
        "after_snapshot_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "After Snapshot Id",
          "type": "string"
        },
        "analysis_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Analysis Id",
          "type": "string"
        },
        "authorship": {
          "$ref": "#/$defs/Authorship"
        },
        "before_graph": {
          "$ref": "#/$defs/SemanticGraph"
        },
        "before_snapshot_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Before Snapshot Id",
          "type": "string"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/Change"
          },
          "title": "Changes",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        },
        "limitations": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "node_matches": {
          "items": {
            "$ref": "#/$defs/NodeMatch"
          },
          "title": "Node Matches",
          "type": "array"
        },
        "obligation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "title": "Obligation Ids",
          "type": "array"
        },
        "policy_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_version": {
          "const": "0.3.0",
          "default": "0.3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "analysis_id",
        "case_id",
        "before_snapshot_id",
        "after_snapshot_id",
        "authorship",
        "node_matches",
        "before_graph",
        "after_graph",
        "changes",
        "task_ref",
        "policy_ref",
        "obligation_ids",
        "limitations"
      ],
      "title": "AnalysisBundle",
      "type": "object"
    },
    "ArtifactCollection": {
      "additionalProperties": false,
      "properties": {
        "artifact_kinds": {
          "additionalProperties": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "title": "Artifact Kinds",
          "type": "object"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "collection_status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "NOT_STARTED"
          ],
          "title": "Collection Status",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        },
        "missing_kinds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "title": "Missing Kinds",
          "type": "array"
        },
        "observed_kinds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "title": "Observed Kinds",
          "type": "array"
        },
        "required_kinds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "title": "Required Kinds",
          "type": "array"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.3.0",
          "default": "0.3.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "artifacts",
        "artifact_kinds",
        "required_kinds",
        "observed_kinds",
        "missing_kinds",
        "collection_status"
      ],
      "title": "ArtifactCollection",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        },
        "kind": {
          "enum": [
            "source",
            "generated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "enum": [
            "application/json",
            "text/plain"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "0.3.0",
          "default": "0.3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 8388608,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size_bytes",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Authorship": {
